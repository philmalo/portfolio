---
import Link from './Link.astro';

interface LinkProps {
    id: string;
    href: string;
    dataset: string;
    label: string;
}
interface Props {
    links: LinkProps[];
}

const { links }: Props = Astro.props;
---

{links.map(link =>(
    <Link
    id={link.id}
    href={link.href}
    dataset={link.dataset}
    label={link.label}
    />
))}