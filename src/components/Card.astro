---
import Navigation from "@components/Navigation.astro";
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getEntry, getCollection, render } from 'astro:content';

const lang = (Astro.currentLocale ?? 'fr') as 'fr' | 'en';

const entries = (await getCollection('demos', e => e.id.startsWith(`${lang}/`)))
	.sort((a, b) => a.data.order - b.data.order);

const demos =await Promise.all(entries.map(
	async entry => ({entry, Content: (await render(entry)).Content })
));

const navData = await getEntry('strings', lang);
if (!navData) throw new Error(`Missing nav entry for lang "${lang}"`);
const nav = navData.data.nav
---

{demos.map(({ entry, Content }) => (
	<article>
			<h2>{entry.data.title} <span>&rarr;</span></h2>
			<Image src={entry.data.img as ImageMetadata} alt={entry.data.alt} />
			<div class="body"><Content /></div>
			<footer class="meta">
					<p class="stack">{entry.data.stack.join(' · ')}</p>
					<p class="actions">
							{entry.data.repo && <a class="links" href={entry.data.repo}>source</a>}
							{entry.data.link && (
								entry.data.modal ? (
									<>
										<a class="links" href={entry.data.link} data-modal={`modal-${entry.id.replace('/', '-')}`}>
											{nav.explore.toLowerCase()}
										</a>
										<dialog id={`modal-${entry.id.replace('/', '-')}`} class="demo-modal">
											<iframe src={entry.data.link} title={entry.data.title} loading="lazy"></iframe>
										</dialog>
									</>
								) : (
									<a class="links" href={entry.data.link}>{nav.explore.toLowerCase()}</a>
								)
							)}
					</p>
			</footer>
	</article>
))}

<script>
	function setupDemoModals() {
		document.querySelectorAll<HTMLAnchorElement>('a[data-modal]').forEach(link => {
			const dialog = document.getElementById(link.dataset.modal!) as HTMLDialogElement | null;
			if (!dialog) return;

			link.addEventListener('click', e => {
				e.preventDefault();
				dialog.showModal();
			});
			// clic sur le fond : la cible est le <dialog> lui-même, pas l'iframe
			dialog.addEventListener('click', e => {
				if (e.target === dialog) dialog.close();
			});
		});
	}
	document.addEventListener('astro:page-load', setupDemoModals);
</script>