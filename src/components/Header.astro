---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getEntry } from 'astro:content';
import LanguagePicker from './LanguagePicker.astro';
import Navigation from './Navigation.astro';

const lang = Astro.currentLocale ?? 'fr';
const data = await getEntry('strings', lang);
if (!data) throw new Error(`Missing strings entry for lang "${lang}"`)

const strings = data.data.nav
---

<header>
    <div>
        <h1>Philippe Malo</h1>
        <h2>Web Dev</h2>
    </div>
    <div>
        <nav>
            <Navigation links={[
            { id: "home", href: getRelativeLocaleUrl(lang, 'home'), dataset: "~", label: strings.home },
            { id: "about", href: getRelativeLocaleUrl(lang, 'about'), dataset: "whoami", label: strings.about },
            { id: "demos", href: getRelativeLocaleUrl(lang, 'demos'), dataset: "lynx https://philippemalo.dev/", label: strings.demos },
            { id: "contact", href: getRelativeLocaleUrl(lang, 'contact'), dataset: "npm view npm contributors", label: strings.contact },
            ]} />
        </nav>
        <nav class="lang">
            <LanguagePicker />
        </nav>
    </div>
</header>