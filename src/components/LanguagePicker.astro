---
import { i18n } from 'astro:config/server';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getEntry } from 'astro:content';

const currentPath = Astro.url.pathname.replace(/^\/(en\/)?/, '');
const entries = (await Promise.all(
        (i18n?.locales ?? []).map((lang) => {
            const code = typeof lang === 'string' ? lang : lang.path;
            return getEntry('strings', code);
        })
    )).filter((entry) => entry !== undefined);
if (!entries) throw new Error('Missing language entries');
---

{entries.map((entry) =>(
    <a href={getRelativeLocaleUrl(entry.id, currentPath)}>{entry.data.languageName}</a>
))}