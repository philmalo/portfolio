---
import Layout from '../../layouts/Layout.astro';
import Terminal from '../../components/Terminal.jsx';
import { getEntry, render } from 'astro:content';
import { getStaticPaths } from '../../i18n/utils';

export { getStaticPaths }

const lang = Astro.currentLocale ?? 'fr';
const entry = await getEntry('pages', `${lang}/about`);
if (!entry) throw new Error(`Missing page entry for lang "${lang}"`)
const { Content } = await render(entry);
---

<Layout title={entry.data.title} description={entry.data.description}>
    <main>
		<Terminal
            client:load
            command="whoami"
            origin=".about"
            displayContent="block"
        />
        <section class="page-section about">
            <article>
                <Content />
            </article>
        </section>
    </main>
</Layout>