---
import Layout from '../../layouts/Layout.astro';
import textFr from "../../assets/loading_fr.js";
import textEn from "../../assets/loading_en.js";
import { getEntry } from 'astro:content';
import { getStaticPaths } from '../../i18n/utils';

export { getStaticPaths }

const lang = Astro.currentLocale ?? 'fr';

const text = lang === 'fr' ? textFr : textEn;

const data = await getEntry('strings', lang);
if (!data) throw new Error(`Missing strings entry for lang "${lang}"`)
const layout = data.data.meta.index;

const redirectTo = lang === 'fr' ? `/home` : `${lang}/home`
---

<Layout
    title={layout.title}
    description={layout.description}
    ogTitle={layout.ogTitle}
    ogDescription={layout.ogDescription}
>
    <pre class="code"></pre>
</Layout>

<script is:inline define:vars={{ text, redirectTo }}>
    const firstLoadOutputElement = document.querySelector("pre.code");

    document.querySelector("header").classList.add("hidden");
    document.querySelector("footer").classList.add("hidden");

    function typeWriter2(outputElement, text, index) {
        outputElement.classList.add("paused");

        if (index < text.length) {
            outputElement.innerHTML += text.charAt(index);
            index++;

            setTimeout(() => {
                if (index >= text.length) {
                    outputElement.classList.remove("paused");

                    document.head.innerHTML +=
                        `<meta http-equiv="refresh" content="0;url=${redirectTo}" />`;
                }
                else {
                    typeWriter2(outputElement, text, index);
                }
            }, 5);
        }
    }

    typeWriter2(firstLoadOutputElement, text, 0);
</script>