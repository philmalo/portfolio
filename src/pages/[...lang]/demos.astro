---
import Layout from '@layouts/Layout.astro';
import Terminal from '@components/Terminal.jsx';
import Result from '@components/Result.astro';
import { getEntry } from 'astro:content';
import { getStaticPaths } from '@i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';

export { getStaticPaths }

const lang = Astro.currentLocale ?? 'fr';

const data = await getEntry('strings', lang);
if (!data) throw new Error(`Missing page entry for lang "${lang}"`)
const layout = data.data.meta.demos
---

<Layout title={layout.title} description={layout.description}>
    <main>
        <Terminal
            client:load
            command={`ls ${getRelativeLocaleUrl(lang, 'demos')}`}
            origin=".demos"
            displayContent="flex"
        />
        <Result />
    </main>
</Layout>